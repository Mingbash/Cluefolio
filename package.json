{
  "name": "xhs-skill-distiller",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk"
  ],
  "scripts": {
    "dev": "node --import tsx apps/server/index.ts",
    "build": "tsc -p packages/sdk/tsconfig.build.json && tsc --noEmit && vite build",
    "start": "node --import tsx apps/server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "cli": "node --import tsx scripts/cli.ts",
    "context:mcp": "node --import tsx scripts/context-mcp.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "evaluate:context": "node --import tsx scripts/evaluate-context.ts",
    "release:source": "node --import tsx scripts/release-source.ts",
    "release:candidate": "node --import tsx scripts/release-archive.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
